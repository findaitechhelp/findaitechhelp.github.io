{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 build.py --release",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {"source":"/buffalo-ny/","destination":"/ny/buffalo/","permanent":true},
    {"source":"/dallas-tx/","destination":"/tx/dallas/","permanent":true}
  ],
  "headers": [
    {"source":"/(.*)","headers":[
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
      {"key":"X-Frame-Options","value":"DENY"}
    ]}
  ]
}
