#!/usr/bin/env python
"""Enforce the configured publication mode; full launch still uses strict release gates."""
import json
import subprocess
import sys
from pathlib import Path
config=json.loads(Path('vercel.json').read_text())
review=config.get('buildCommand')=='python3 build.py --public-review'
commands=([[sys.executable,'tools/validate.py'],[sys.executable,'tools/check_public_review.py']] if review else [[sys.executable,'tools/check_links.py'],[sys.executable,'build.py','--release']])
for command in commands:
    result=subprocess.run(command)
    if result.returncode:raise SystemExit(result.returncode)
